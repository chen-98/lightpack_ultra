<div class="lpList lp {{#optionalFields.images}}lpShowImages{{/optionalFields.images}} {{#optionalFields.worn}}lpShowWorn{{/optionalFields.worn}} {{#optionalFields.consumable}}lpShowConsumable{{/optionalFields.consumable}} {{#optionalFields.price}}lpShowPrices{{/optionalFields.price}}">
    {{#styles}}
        <link href="{{{baseUrl}}}/dist/{{{.}}}" rel="stylesheet" type="text/css" />
    {{/styles}}
    <style>.lpModalOverlay, #lpImageDialog { display: none; }
    .lpList { padding: 0; } </style>
    <h2 class="lpListName" >{{listName}}</h2>
    <div class="lpShareSummary">
        <div class="lpShareSummaryGrid">
            <div><strong>Total</strong><span>{{shareSummary.totalWeightDisplay}} {{shareSummary.unit}}</span></div>
            <div><strong>Pack</strong><span>{{shareSummary.totalPackWeightDisplay}} {{shareSummary.unit}}</span></div>
            <div><strong>Base</strong><span>{{shareSummary.totalBaseWeightDisplay}} {{shareSummary.unit}}</span></div>
            {{#shareSummary.hasWornWeight}}<div><strong>Worn</strong><span>{{shareSummary.totalWornWeightDisplay}} {{shareSummary.unit}}</span></div>{{/shareSummary.hasWornWeight}}
            {{#shareSummary.hasConsumableWeight}}<div><strong>Consumable</strong><span>{{shareSummary.totalConsumableWeightDisplay}} {{shareSummary.unit}}</span></div>{{/shareSummary.hasConsumableWeight}}
        </div>
    </div>
    <div class="lpListSummary">
        <div class="lpChartContainer">
            <canvas class="lpChart" height="260" width="260"></canvas>
        </div>
        <div class="lpTotalsContainer">
            {{{renderedTotals}}}
        </div>
    </div>

    <div style="clear:both"></div>

    {{#renderedDescription}}
        <div id="lpListDescription">
            <h2>Description</h2>
            {{{renderedDescription}}}
        </div>
    {{/renderedDescription}}

    <ul class="lpCategories">{{{renderedCategories}}}</ul>
</div>
<div class="lpDialog" id="lpImageDialog"></div>
<div id="lpModalOverlay"></div>
